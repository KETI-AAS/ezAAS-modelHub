logs/
nohup.out
hs_err_pid*.log
replay_pid*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 업로드 / 임시 데이터 ----------
.tmp/
tmp/
temp/
aas_files/
*.aasx.bak

