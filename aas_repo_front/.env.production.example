# .env.production.example — 운영 배포용 템플릿
#   cp .env.production.example .env.production  후 도메인을 채우세요.
# .env.production 은 .gitignore 대상입니다 (환경마다 값이 달라서).

NEXT_PUBLIC_SITE_URL=https://ezmodel-hub.re.kr

# 클라이언트 사이드 렌더링용
NEXT_PUBLIC_AAS_API_BASE=https://ezmodel-hub.re.kr
NEXT_PUBLIC_AAS_API_PORT=

# 서버 사이드 렌더링용 (컨테이너 내부 통신)
NEXT_PUBLIC_AAS_API_BASE_SERVER=http://backend
NEXT_PUBLIC_AAS_API_PORT_SERVER=8000
